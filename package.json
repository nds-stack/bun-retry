{
  "name": "@nds-stack/bun-retry",
  "version": "0.1.0-alpha.0",
  "description": "Zero-dependency retry/backoff utility for Bun — exponential backoff, jitter, fibonacci, timeout, AbortSignal support.",
  "author": "nds-stack <nds.stack@gmail.com>",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "build": "bun build ./src/index.ts --outdir=./dist --target=bun --format=esm && bunx tsc -p tsconfig.build.json",
    "bench": "bun run bench/retry.bench.ts",
    "prepublishOnly": "bun run build && bun test"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "devDependencies": {
    "@types/bun": "latest"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "license": "MIT"
}
